<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows its own splash before ours, while the OS's Dark Mode
         setting is off. It uses the same dark color as the launch background.
         The launcher icon is a plain square image with no adaptive foreground,
         so the system splash icon is the background color itself: only the
         dark screen shows, then the Flutter splash takes over. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
